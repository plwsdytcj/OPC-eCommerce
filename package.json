{
  "name": "opc",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-border OPC AI Workforce & Incubation Platform",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @opc/db generate",
    "db:migrate": "pnpm --filter @opc/db migrate",
    "db:seed": "pnpm --filter @opc/db seed",
    "db:studio": "pnpm --filter @opc/db studio",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "infra:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0"
  }
}
