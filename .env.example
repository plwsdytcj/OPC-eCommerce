# ===== Database =====
DATABASE_URL=postgresql://opc:opc@localhost:5432/opc

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Object Storage (MinIO) =====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=opc
S3_SECRET_KEY=opcopcopc
S3_BUCKET=opc-artifacts
S3_REGION=us-east-1

# ===== ArkClaw =====
ARKCLAW_API_BASE=https://arkclaw.example.com
ARKCLAW_API_KEY=replace-me
ARKCLAW_CALLBACK_BASE=http://localhost:4001

# ===== Auth (JWT, MVP) =====
JWT_SECRET=dev-only-change-me
JWT_ISSUER=opc-mvp

# ===== Service Ports =====
ARKCLAW_BRIDGE_PORT=4001
MARKETPLACE_PORT=4002
WORKFLOW_PORT=4003
TASK_PORT=4004

# ===== Logging =====
LOG_LEVEL=info
NODE_ENV=development
