# OPC 生产环境变量模板 ─ 拷贝为 .env 后填好
# 切勿把填好的 .env 提交到 git！.gitignore 已忽略。

# ── 域名 ────────────────────────────────────────────────────
# 你在阿里云买的域名。例：opc-park.com / mulemate.com
DOMAIN=opc.your-domain.com

# Let's Encrypt 注册邮箱（用于证书到期提醒）
ACME_EMAIL=you@example.com

# 公网可见的 marketplace base url（前端 sample 按钮跳转用）
# 默认是同域：https://{DOMAIN}
PUBLIC_PAPERCLIP_BASE=https://work.opc.your-domain.com

# Paperclip 公司 prefix（marketplace sample 链接拼这个）
COMPANY_PREFIX=OPC


# ── LLM 凭据 ────────────────────────────────────────────────
# 至少要给一个能用的。listing-pro 等 8 个 agent 默认 adapter 是 codex_local，
# 所以 OPENAI_API_KEY 是必填；ANTHROPIC 用于切换 claude_local。
OPENAI_API_KEY=sk-...

# 可选：如果你用 Anthropic 直连
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                # 留空走官方 api.anthropic.com

# ── Paperclip 部署模式 ──────────────────────────────────────
# authenticated = 必须登录才能操作；anonymous = 任何人都能进（不推荐生产）
PAPERCLIP_DEPLOYMENT_MODE=authenticated

# private = 仅自己人 / shared = 可邀请协作
PAPERCLIP_DEPLOYMENT_EXPOSURE=shared

# board 级 token（首次登录用，之后 paperclip 自动签 JWT）
# 用 `openssl rand -hex 32` 生成
PAPERCLIP_BOARD_AUTH_TOKEN=请用-openssl-rand-hex-32-生成


# ── 可选：未来要接 RDS Postgres 时改这里 ─────────────────────
# DATABASE_URL=postgresql://opc:password@your-rds-endpoint:5432/paperclip
