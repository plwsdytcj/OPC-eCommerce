# OPC 生产环境变量模板 ─ 拷贝为 .env 后填好
# 切勿把填好的 .env 提交到 git！.gitignore 已忽略 .env*。

# ── 域名（暂时没域名就留空，用 IP 直连） ─────────────────────
# 没有域名时把 DOMAIN 留空，Caddy 会自动用 :80 监听 IP 直接 serve。
# 有域名后再填 例：opc-park.com / mulemate.com
DOMAIN=

# Let's Encrypt 注册邮箱（有域名走 HTTPS 时才用到）
ACME_EMAIL=you@example.com

# Paperclip 公司 prefix（marketplace sample 链接拼这个）
COMPANY_PREFIX=OPC


# ── LLM 凭据（核心配置）──────────────────────────────────────
#
# 我们用「火山方舟豆包大模型」替代 OpenAI（国内直连，价格低 10 倍，中文质量更好）。
# 它提供 OpenAI 兼容的 endpoint，codex CLI 完全不用改代码，只换变量。
#
# 1. 去 https://console.volcengine.com/ark 开通方舟
# 2. 创建 "API Key"      → 填到 OPENAI_API_KEY
# 3. 创建 "推理接入点"   → 接入点 ID（形如 ep-2026xxxx-xxxx）填到 OPENAI_MODEL
#    模型选 doubao-pro-32k 或 doubao-pro-256k 都行；
#    长 listing/英文用 256k，中文短任务用 32k 性价比最高。
#
OPENAI_API_KEY=替换为火山方舟-API-Key
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_MODEL=替换为推理接入点ID-ep-...

# 可选：如果你想给某个 agent 用 Anthropic Claude（默认 8 个 agent 都走豆包）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                # 留空走官方 api.anthropic.com


# ── Paperclip 部署模式 ──────────────────────────────────────
# authenticated = 必须登录才能操作；anonymous = 任何人都能进（不推荐生产）
PAPERCLIP_DEPLOYMENT_MODE=authenticated

# private = 仅自己人 / shared = 可邀请协作
PAPERCLIP_DEPLOYMENT_EXPOSURE=shared

# board 级 token（首次登录用，之后 paperclip 自动签 JWT）
# 部署脚本会自动用 openssl 生成填到这里；你不用动
PAPERCLIP_BOARD_AUTH_TOKEN=自动生成-请保持原样


# ── 可选：未来接独立 PostgreSQL 时改这里 ─────────────────────
# DATABASE_URL=postgresql://opc:password@your-rds-endpoint:5432/paperclip
